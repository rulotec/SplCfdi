<?xml version="1.0"?>
<xs:schema xmlns:SANMINA="https://webapps2.sanmina-sci.com/partners-access" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://webapps2.sanmina-sci.com/partners-access" attributeFormDefault="unqualified" elementFormDefault="qualified">
    <xs:element name="AP">
        <xs:annotation><xs:documentation>Definición de Schema para el envío de información adicional de la factura electrónica para SANMINA</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:attribute name="PONumber" use="optional"><xs:annotation><xs:documentation>Orden de Compra</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute>
		<xs:attribute name="email" use="required"><xs:annotation><xs:documentation>Dirección de Correo Electrónico del Provedoor</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="LegalEntityName" use="required"><xs:annotation><xs:documentation>Razón Social a quién va dirigido el documento</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="CustomerCode"><xs:annotation><xs:documentation>Códico de Cliente (Asignado por Sanmina-SCI)</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="Currency" use="required"><xs:annotation><xs:documentation>Moneda</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="ExchangeRate" use="required"><xs:annotation><xs:documentation>Tipo de cambio del peso mexicano con respecto a la moneda extranjera</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="InternalInvoiceNumber" use="optional"><xs:annotation><xs:documentation>Numero Interno del Documento</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
    </xs:element>
    
</xs:schema>