{
	"name" : "spl/cfdi-core",
	"description" : "Generación de CFDI 4.0, independiente de framework",
	"type" : "library",
	"require" : {
		"php" : ">=8.1",
		"ext-bcmath" : "*",
		"ext-dom" : "*",
        "ext-libxml": "*"
	},
	"autoload" : {
		"psr-4" : {
			"SplCfdi\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"SplCfdi\\Tests\\" : "tests/"
		}
	},
	"bin" : [
		"bin/cfdi-catalogs"
	],
	"scripts" : {
		"test" : "phpunit",
		"catalogs" : "php bin/cfdi-catalogs check",
		"analyse" : "phpstan analyse --no-progress",
		"check" : [
			"@analyse",
			"@test",
			"@catalogs"
		]
	},
	"require-dev" : {
		"phpunit/phpunit" : "^11.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0"
	}
}
